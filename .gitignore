assets/jma/
assets/sound/
assets/voice/
assets/pic/*.BMg
assets/pic/*.bmg
assets/pic/*.JMG
assets/pic/*.jmg
assets/pic/*.JMg
assets/data/*.MMG
assets/data/*.emg
assets/data/odd.dat
