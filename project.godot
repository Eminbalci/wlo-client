; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="WonderlandOnlineClient"
run/main_scene="res://scenes/ui/login_screen.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

ArchiveLoader="*res://scripts/core/archive_loader.gd"
GameDatabase="*res://scripts/database/game_database.gd"
CursorManager="*res://scripts/core/cursor_manager.gd"
AuthAudio="*res://scripts/ui/auth/auth_audio.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/aspect="ignore"
window/size/min_size=Vector2i(800, 600)

[gui]

theme/custom_font="res://assets/fonts/NotoSansTC-Regular.ttf"

